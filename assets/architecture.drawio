        <mxCell id="e-fn-gal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;endSize=5;exitX=1;exitY=0.98;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="s3gal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="596" y="187"/><mxPoint x="596" y="556"/></Array></mxGeometry></mxCell>
        <mxCell id="e-gal-kms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;endSize=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3gal" target="kms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-cw-sns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;endSize=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cw" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g-legend" value="How a request flows" style="fillColor=#EDF3FF;strokeColor=#6C8EBF;rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#232F3E;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=1.5;spacingTop=0;" vertex="1" parent="frame"><mxGeometry x="900" y="58" width="340" height="444" as="geometry"/></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="32" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-1" value="The browser loads the page from CloudFront, which serves the built files from a private S3 bucket." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="35" width="286" height="52" as="geometry"/></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="88" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-2" value="API calls go through CloudFront to the REST API and on to the app's one Lambda function." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="91" width="286" height="36" as="geometry"/></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="128" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-3" value="Open pages hold a WebSocket connection. The function pushes live updates back through it." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="131" width="286" height="52" as="geometry"/></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="184" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-4" value="The function reads and writes seven DynamoDB tables." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="187" width="286" height="36" as="geometry"/></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="224" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-5" value="The function reads the invite code from Secrets Manager." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="227" width="286" height="36" as="geometry"/></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="264" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-6" value="A question for the agent runs the AgentCore runtime, which calls Claude Haiku 5.5 on Bedrock." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="267" width="286" height="52" as="geometry"/></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="320" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-7" value="EventBridge Scheduler runs the function once a minute." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="323" width="286" height="36" as="geometry"/></mxCell>
        <mxCell id="legend-badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="360" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-8" value="That run writes the gallery snapshot to the HouseBucket's S3 bucket, encrypted with its own KMS key." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="363" width="286" height="52" as="geometry"/></mxCell>
        <mxCell id="legend-badge-9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="g-legend"><mxGeometry x="12" y="416" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="legend-text-9" value="Three CloudWatch alarms notify an SNS topic." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-legend"><mxGeometry x="44" y="419" width="286" height="20" as="geometry"/></mxCell>
        <mxCell id="g-more" value="Other resources" style="fillColor=#F5F5F5;strokeColor=#666666;rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#232F3E;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=1.5;spacingTop=0;" vertex="1" parent="frame"><mxGeometry x="900" y="514" width="340" height="152" as="geometry"/></mxCell>
        <mxCell id="more-text" value="Five more S3 buckets: access logs for the site, access logs for the gallery, the app's config file, the config bucket's logs, and one for the Agent Block. 13 IAM roles. 10 deploy-time helper functions. 155 resources in all." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;spacingTop=-2;" vertex="1" parent="g-more"><mxGeometry x="12" y="30" width="316" height="116" as="geometry"/></mxCell>
