        <mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="146" y="183" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="496" y="183" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="451" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1090" y="416" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1240" y="201" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="728" y="534" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="516" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="legend-bg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6C8EBF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1440" height="190" as="geometry"/></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="784" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-1" value="The browser loads the page from CloudFront, which serves the built files from a private S3 bucket." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="86" y="782" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="818" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-2" value="API calls go through CloudFront to the REST API (/cdk-blocks/api) and on to the app's one Lambda function." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="86" y="816" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="852" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-3" value="Open pages hold a WebSocket connection for live updates: new gallery builds and the here-now count." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="86" y="850" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="886" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-4" value="The function keeps builds, budgets and picks in DynamoDB and reads the invite code from Secrets Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="86" y="884" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="784" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-5" value="Asking the agent runs the AgentCore runtime, which calls the model in Amazon Bedrock." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="801" y="782" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="818" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-6" value="Once a minute the schedule runs the function, which writes the gallery snapshot to the HouseBucket." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="801" y="816" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="852" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-text-7" value="CloudWatch alarms notify an SNS topic. Nobody is subscribed until you add an address." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="801" y="850" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-note" value="&lt;b&gt;Also in the stack, not drawn:&lt;/b&gt; 13 IAM roles, 10 deploy-time helper functions, a Step Functions state machine, 3 CloudFront functions and an edge key-value store, 4 more S3 buckets (the app's config file, one for the Agent Block, and two for logs), a second KMS key for the alarm topic, and 3 log groups." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="765" y="884" width="680" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
