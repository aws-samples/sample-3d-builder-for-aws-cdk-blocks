{
  "name": "sample-3d-builder-for-aws-cdk-blocks",
  "version": "1.0.0",
  "license": "MIT-0",
  "type": "module",
  "blocksTemplate": "react",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "cdk-blocks",
    "packages/bb-house-bucket"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "spec": "blocks-generate-spec",
    "preown-synth": "node scripts/setup.mjs",
    "own-synth": "tsx cdk-blocks/scripts/own-synth.ts",
    "dev:server": "tsx watch cdk-blocks/scripts/server.ts",
    "dev": "tsx watch cdk-blocks/scripts/server.ts",
    "dev:stop": "tsx cdk-blocks/scripts/stop.ts",
    "presandbox": "node scripts/setup.mjs",
    "sandbox": "tsx cdk-blocks/scripts/sandbox.ts",
    "presandbox:deploy": "node scripts/setup.mjs",
    "sandbox:deploy": "tsx cdk-blocks/scripts/sandbox.ts --deploy-only",
    "presandbox:preview": "node scripts/setup.mjs",
    "sandbox:preview": "tsx cdk-blocks/scripts/sandbox.ts --preview",
    "sandbox:destroy": "tsx -C cdk cdk-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx cdk-blocks/scripts/console.ts",
    "prebuild": "npm run build:block && blocks-generate-client",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "node scripts/setup.mjs",
    "deploy": "tsx cdk-blocks/scripts/deploy.ts",
    "secret": "tsx cdk-blocks/scripts/secret.ts",
    "pretypegen": "node scripts/setup.mjs",
    "typegen": "tsx cdk-blocks/scripts/typegen.ts",
    "destroy": "tsx cdk-blocks/scripts/destroy.ts",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "test:caps": "tsx -C browser test/caps.test.ts",
    "test:contrast": "tsx test/contrast.test.ts",
    "test:connections": "tsx test/connections.test.ts",
    "test:custom": "tsx test/custom.test.ts",
    "test:backend": "tsx test/backend.test.ts",
    "data:split": "node scripts/split-page-data.mjs",
    "build:block": "npm run build -w @your-team/bb-house-bucket",
    "test:block": "npm run build -w @your-team/bb-house-bucket && npm test -w @your-team/bb-house-bucket",
    "prepare": "node scripts/setup.mjs && npm run build:block",
    "pretypecheck": "npm run build:block",
    "predev": "node scripts/setup.mjs && npm run build:block",
    "predev:server": "node scripts/setup.mjs && npm run build:block",
    "vendorize": "blocks-vendorize",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "knip": "knip",
    "test": "npm run test:connections && npm run test:custom && npm run test:backend && npm run test:block",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test",
    "scan": "bash scripts/scan.sh",
    "licenses": "npx --yes license-checker-rseidelsohn@5.0.1 --production --excludePrivatePackages --summary --onlyAllow 'MIT;MIT-0;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;OFL-1.1;CC0-1.0;0BSD;BlueOak-1.0.0' --excludePackages 'parse-cache-control@1.0.1'",
    "prenag": "node scripts/setup.mjs",
    "nag": "cdk synth --quiet --app \"npx tsx -C cdk cdk-blocks/scripts/cdk-nag.ts\" -o cdk.out/nag"
  },
  "dependencies": {
    "@aws-cdk-blocks/bb-agent": "1.0.0",
    "aws-cdk-blocks": "1.0.0",
    "@aws-cdk-blocks/hosting": "1.0.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@your-team/bb-house-bucket": "file:packages/bb-house-bucket",
    "@react-spring/three": "10.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "maath": "0.10.8",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-cdk-blocks/bb-realtime": "1.0.0",
    "@biomejs/biome": "2.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.278.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "knip": "6.46.1",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "blocksTemplateVersion": "0.1.0",
  "description": "A 3D builder for AWS CDK Blocks, as a deployed sample app (Agent, Realtime, KVStore, CronJob, Logger, Metrics, Dashboard, Secret, the custom Block HouseBucket, and the Hosting construct)",
  "blocksTemplateDescription": "Vite + React 19 frontend (scaffolded from the react template; the todo app was replaced)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aws-samples/sample-3d-builder-for-aws-cdk-blocks.git"
  }
}
